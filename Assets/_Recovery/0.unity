  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraccion
  nombreNPC: "Ping\xFCino de Humbolt"
  retrato:
  - {fileID: 1649693849891353376, guid: 4d4d36c41091f1e47886f41b7ad9d309, type: 3}
  - {fileID: -8107016009217817367, guid: 4d4d36c41091f1e47886f41b7ad9d309, type: 3}
  - {fileID: -6815400752981935453, guid: 4d4d36c41091f1e47886f41b7ad9d309, type: 3}
  - {fileID: -790018546326536445, guid: 4d4d36c41091f1e47886f41b7ad9d309, type: 3}
  dialogos:
  - "Comemos micropl\xE1sticos creyendo que es comida de verdad, y eso llena nuestro
    est\xF3mago sin darnos ning\xFAn nutriente."
  - "Terminamos sinti\xE9ndonos llenos... mientras nos morimos de hambre por dentro.
    As\xED de enga\xF1oso es el pl\xE1stico en el mar."
  yaHablo: 0
  mostrarMensajesEnConsola: 0
