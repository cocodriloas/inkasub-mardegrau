  m_Script: {fileID: 11500000, guid: b142f1a50ef692142a9469febdf81a68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraccion
  nombreNPC: Mero
  retrato:
  - {fileID: 8843534436996814398, guid: c8e914a037f5c9146a3b03a98309d413, type: 3}
  - {fileID: 4515748463088756379, guid: c8e914a037f5c9146a3b03a98309d413, type: 3}
  - {fileID: -6214746962194623767, guid: c8e914a037f5c9146a3b03a98309d413, type: 3}
  - {fileID: 687670507113241001, guid: c8e914a037f5c9146a3b03a98309d413, type: 3}
  dialogos:
  - "\xBFVes esas corrientes que giran sin parar? Llevan d\xE9cadas empujando basura
    hacia un mismo punto del oc\xE9ano, y con el tiempo se form\xF3 algo nuevo: la
    Plastisfera. Millones de fragmentos de pl\xE1stico, tan juntos que hasta bacterias
    y algas empezaron a vivir sobre ellos, como si fuera un ecosistema propio."
  - "Pero es un ecosistema que no deber\xEDa existir. Ten cuidado ah\xED abajo, Inka
    Sub. Eso que crece en la fosa... ya no es solo basura."
  yaHablo: 0
  mostrarMensajesEnConsola: 0
